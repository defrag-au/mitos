# Written by up.sh if absent. The two tokens must differ: the host refuses a
# namespace whose token is the operator token, because one bearer token has to
# resolve to exactly one principal.
#
# MITOS_AUTH_TOKEN  — the host's operator token; use it for admin curls.
# MITOS_TOKEN_DEV   — the `dev` namespace token; the worker's MITOS_AUTH_TOKEN.
MITOS_AUTH_TOKEN=replace-with-openssl-rand-hex-32
MITOS_TOKEN_DEV=replace-with-a-different-openssl-rand-hex-32
