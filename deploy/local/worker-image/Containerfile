# `wrangler dev` only — the worker was built on the host by
# scripts/build-worker.sh, and up.sh stages its output into .tmp/worker/.
FROM node:22-bookworm-slim

RUN npm install --global wrangler@4.62.0

# wrangler.toml declares `[build] command = "../../scripts/build-worker.sh"`,
# and `wrangler dev` runs it even with --no-bundle. The worker is already built
# and mounted at /app/build, so make that path a no-op. From /app, `../..` is /.
RUN mkdir -p /scripts \
    && printf '#!/bin/sh\nexit 0\n' > /scripts/build-worker.sh \
    && chmod 0755 /scripts/build-worker.sh

WORKDIR /app
