// Mitos platform v1 ABI.
//
// See ../../../docs/strategy/MITOS_PLATFORM_V1.md for the full
// rationale and ../../../spikes/wit-spike/wit/world.wit for the
// proven-out shape this is promoted from.
//
// Stability: 0.x. The `module-version` export is the binding
// stability promise; bumped on any breaking change to this WIT.

package mitos:platform;

interface types {
    record output-ref {
        tx-hash: list<u8>,
        index: u32,
    }

    record asset-id {
        policy: list<u8>,
        name: list<u8>,
    }

    /// Resolved datum. The host populates `payload` regardless of
    /// whether the on-chain output carried the datum inline or as
    /// a hash reference into the witness set / archive — modules
    /// see only the bytes. This is the **caller-blind datum
    /// resolution** principle from `MITOS_DATA_PLANE_API.md`:
    /// inline-vs-hash is the plane's concern and never surfaces
    /// in the guest API. Modules should never branch on a
    /// "kind: inline | hash" discriminator — there isn't one,
    /// deliberately.
    ///
    /// `hash` is always present (when a datum exists at all).
    /// `payload` is the literal on-chain CBOR; modules decode
    /// locally via `ciborium` / `pallas-codec`.
    record typed-datum {
        hash: list<u8>,
        payload: list<u8>,
    }

    /// Output projected through the data plane. Lean variant of
    /// `mitos_data_plane::TypedOutput` for crossing the WIT
    /// boundary cheaply; expand on demand if real workloads need
    /// more fields.
    ///
    /// **Datum bytes are accessed via separate methods on
    /// `resolved-block`** (`get-output-datum`,
    /// `get-consumed-input-datum`) rather than carried on this
    /// record. Records are positionally-encoded in Canonical ABI
    /// so adding a field is a major-bump-breaking change; resource
    /// methods are additive. Indexers that need datum bytes call
    /// the dedicated method; indexers that don't pay nothing.
    record typed-output {
        address: string,
        lovelace: u64,
        assets: list<asset-entry>,
    }

    record asset-entry {
        asset: asset-id,
        quantity: u64,
    }

    /// How aggressively the host should pre-decode datums and
    /// scripts before handing the result to the module. Mirrors
    /// `mitos_data_plane::DecodeLevel`.
    ///
    /// This is the **single knob** for datum hydration: setting
    /// `with-datum` triggers caller-blind resolution (host
    /// fetches inline datums from the output, hash-attached
    /// datums from the same-block witness set, cross-block
    /// hashes from Dolos's archive). Modules never call a
    /// separate `plutus-data-by-hash` host fn — that path is
    /// deliberately not in this WIT, because it would re-leak
    /// the inline-vs-hash distinction the data plane is
    /// designed to seal.
    variant decode-level {
        lean,
        with-datum,
        full,
    }

    /// Trap supervision strategy declared by the module. Host
    /// supervisor consults this on every trap.
    variant trap-strategy {
        /// Replay the block on restart. Module promises
        /// idempotent dispatch.
        replay,
        /// Skip the failing block, advance the cursor, log.
        skip-and-mark,
        /// Stop the module, do not advance the cursor.
        quarantine,
    }

    record retry-policy {
        max-retries: u32,
        backoff-cap-ms: u32,
    }
}

/// Snapshot chain-state queries. Proxies into `mitos-data-plane`
/// host-side; modules never touch dolos directly.
interface chain-data {
    use types.{output-ref, typed-output, decode-level};

    /// Bulk lookup of N output refs in one host call. Amortises
    /// the boundary cost; modules should batch where possible.
    read-utxos: func(refs: list<output-ref>, decode: decode-level)
                -> list<typed-output>;

    /// Enumerate the current unspent set at one Cardano address.
    /// Returns the output refs only — modules pair this with
    /// `read-utxos` when they want full outputs + datums.
    ///
    /// Bootstrap primitive for indexers that watch a script
    /// address (marketplaces, DEXes, oracles). Backed by Dolos's
    /// per-address secondary index — fast, no chain replay.
    /// `address` is bech32 (`addr1...` / `addr_test1...`); the
    /// host bech32-decodes once per call.
    ///
    /// Order is unspecified. Result is hard-capped at 100K refs
    /// to bound host-side memory; addresses with more UTxOs are
    /// expected to use the predicate-based `search-utxos` flow
    /// (Phase B+) once it lands. Today's marketplace contracts
    /// hold thousands, not hundreds of thousands.
    utxos-by-address: func(address: string) -> list<output-ref>;
}

/// Module-private KV state. Backed by a per-module redb table
/// host-side. Keys are namespaced under the module's ID; modules
/// cannot reach each other's state.
interface state-kv {
    get-value: func(key: string) -> option<list<u8>>;
    set-value: func(key: string, value: list<u8>);
    delete-value: func(key: string);
}

/// Per-block context handed to the module via `handle-event`.
/// Resource semantics: host owns the underlying decoded block;
/// module pulls fields lazily without paying CBOR marshalling
/// cost on every dispatch. Passed as `borrow<>` so the guest
/// cannot stash it past the call boundary (compile-time enforced
/// by Rust's borrow checker on the bindgen-generated guest
/// stubs).
interface block-context {
    use types.{output-ref, typed-output, typed-datum};

    resource resolved-block {
        slot: func() -> u64;
        tx-count: func() -> u32;

        /// Tx hash bytes (32). Modules emit it as event metadata.
        tx-hash: func(tx-idx: u32) -> list<u8>;

        /// Number of outputs produced by a tx. Eager — host has
        /// the decoded block in hand, no I/O needed.
        output-count: func(tx-idx: u32) -> u32;

        /// Get a produced output by `(tx_idx, output_idx)`.
        /// Eager (decoded host-side already). The hot path for
        /// ownership-style indexers walks `output_count` × this.
        get-output: func(tx-idx: u32, output-idx: u32) -> typed-output;

        /// Lazy consumed-input lookup. First call triggers a
        /// data-plane read; result is memoised for the block's
        /// lifetime. Pure-output indexers (e.g. ownership) never
        /// call this and pay zero resolution cost.
        get-consumed-input: func(tx-idx: u32, input-idx: u32)
                            -> option<typed-output>;

        /// Bulk consumed-input lookup for one tx. Resolves all
        /// inputs in one data-plane call. Marketplace-style
        /// indexers should prefer this over per-input calls.
        get-consumed-inputs: func(tx-idx: u32)
                             -> list<option<typed-output>>;

        /// Resolve the datum on a produced output, regardless of
        /// inline-vs-hash on-chain. Returns `none` if the output
        /// has no datum at all. Per the caller-blind principle,
        /// modules see bytes only — the host fetches inline data
        /// from the output, hash-attached data from the same-
        /// block witness set, or cross-block hashes from Dolos's
        /// archive, all transparently.
        ///
        /// Costs:
        /// - inline / same-block-witness: ~free (already decoded)
        /// - cross-block archive hash: one redb read (~µs warm,
        ///   ~ms cold). Negligible at typical block rates.
        ///
        /// Indexers that don't need datums (e.g. policy-scoped
        /// ownership) never call this and pay zero resolution
        /// cost — same shape as the consumed-input split above.
        get-output-datum: func(tx-idx: u32, output-idx: u32)
                          -> option<typed-datum>;

        /// Same shape for consumed inputs. Resolves the prior
        /// output's datum, regardless of whether the original
        /// was inline or hash-attached. Useful for marketplace
        /// indexers that need to decode the datum of a CO being
        /// spent in order to emit a typed `Spent` event with
        /// offerer pkh / collection target / etc.
        get-consumed-input-datum: func(tx-idx: u32, input-idx: u32)
                                  -> option<typed-datum>;
    }
}

/// Module-side event emission. Host fans events out to the
/// existing CF replication WS without re-encoding.
interface emit {
    /// CBOR-encoded typed event. Channel discriminates the
    /// logical stream the module is publishing on (registered
    /// during `init` via the host-side registry).
    emit-event: func(channel: u32, event: list<u8>);
}

/// Structured logging from the module into the host's `tracing`
/// subscriber. Avoids modules needing to do their own log I/O.
interface logging {
    variant log-level { trace, debug, info, warn, error }

    log: func(level: log-level, target: string, message: string);
}

/// Dynamic interest mechanics — host pushes the companion's filter
/// set into the running module without redeploy. See the design
/// doc's "Dynamic interest mechanics" section in
/// `MITOS_COMPANION_RUNTIME_V1.md`.
///
/// Items cross the boundary as CBOR-encoded `mitos_protocol::Interest`
/// blobs — same wire shape mitos-protocol already defines, so module
/// authors never duplicate the type. Modules persist the resulting
/// filter set via `state-kv` so a host restart without an attached
/// companion still filters correctly until the companion reconnects
/// and replays.
interface interest {
    /// Op semantics matching `mitos_protocol::wire::InterestOp`:
    /// `add` / `remove` are incremental; `replace` swaps the entire
    /// filter set in one shot (used on companion reconnect).
    variant interest-op {
        add,
        remove,
        replace,
    }
}

world mitos-module {
    use types.{trap-strategy, retry-policy};
    use block-context.{resolved-block};
    use interest.{interest-op};

    import chain-data;
    import state-kv;
    import block-context;
    import emit;
    import logging;

    /// ABI version handshake. Host enforces compatibility before
    /// any other call. Bumped on any breaking change. Avoids
    /// Balius's silent breakage from their PR #98.
    export module-version: func() -> tuple<u32, u32>;

    /// Trap supervision policy. Read once at module load; host
    /// supervisor consults on every trap.
    export trap-policy: func() -> tuple<trap-strategy, retry-policy>;

    /// One-shot init at module load. Config is CBOR'd typed config
    /// from the module's shared crate; host transcodes from a
    /// human-edited TOML colocated with `wrangler.toml` in the
    /// dApp's repo.
    export init: func(config: list<u8>);

    /// Single dispatch entry. Channel discriminates the logical
    /// stream; the resource handle borrow does NOT outlive the
    /// call (Rust borrow lifetime enforces this).
    export handle-event: func(channel: u32, block: borrow<resolved-block>);

    /// Dynamic interest mutation. Host calls this when a
    /// `ClientMessage::Interest { op, items }` frame arrives over
    /// the CF replication WS. `items-cbor` is a single CBOR-encoded
    /// `Vec<mitos_protocol::Interest>` blob — host encodes once,
    /// module decodes once, no per-item boundary cost.
    ///
    /// Returning `Err(reason)` surfaces module-side decode /
    /// validation failure to the host without trapping; the host
    /// logs but does not advance the cursor or quarantine.
    /// (Mismatched interest shapes are typically a deploy-version
    /// mismatch — recoverable once the module is bumped.)
    export update-interest: func(op: interest-op, items-cbor: list<u8>)
                            -> result<_, string>;
}
