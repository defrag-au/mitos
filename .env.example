# Copy to .env (gitignored) and fill in. Never commit the real file.
#
# Where tools/mithril-fetch keeps the shared Mithril chunk store. One store
# serves every policy: sealed immutable files are identical for all of them.
MITHRIL_DATA_DIR=/path/to/mithril-chunks

# Optional. Koios is usable without a token at a lower rate limit; the token is
# read by mitos-koios for every Koios call in this workspace.
# KOIOS_TOKEN=your-key-here
